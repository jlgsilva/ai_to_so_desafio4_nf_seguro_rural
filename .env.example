# Copie este arquivo para .env e preencha com sua chave real.
# Nunca faça commit do arquivo .env (ele já está no .gitignore).

GROQ_API_KEY=sua_chave_groq_aqui

# Opcional: só altere se a Groq depreciar os modelos abaixo.
GROQ_MODEL_RACIOCINIO=llama-3.3-70b-versatile
GROQ_MODEL_RAPIDO=llama-3.1-8b-instant
