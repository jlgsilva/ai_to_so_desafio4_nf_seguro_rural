# Copie este arquivo para .env e preencha com sua chave real.
# Nunca faça commit do arquivo .env (ele já está no .gitignore).

GROQ_API_KEY=sua_chave_groq_aqui

# Opcional: só precisa preencher se quiser sobrescrever os modelos
# padrão definidos em src/llm_client.py (que é o único arquivo que
# você precisa editar para trocar de modelo, caso a Groq deprecie
# algum dos atuais de novo). Ver comentário no topo de
# src/llm_client.py para o passo a passo e a tabela de limites
# atualizada. Lista de modelos suportados:
# https://console.groq.com/docs/models
# Limites atualizados da sua conta: https://console.groq.com/settings/limits
GROQ_MODEL_RACIOCINIO=openai/gpt-oss-120b
GROQ_MODEL_RAPIDO=openai/gpt-oss-20b
